# Copy to .env.local and fill in your own values. Never commit the filled-in file.
# Note: everything prefixed with VITE_ is bundled into the client and is visible
# to anyone using the app. Use keys that are domain-restricted and rotatable.

# JSON-RPC endpoint for Base Sepolia (Infura/Alchemy/etc.).
# Leave unset to use the public endpoint https://sepolia.base.org
VITE_BASE_SEPOLIA_RPC_URL=

# ThirdWeb client ID (https://thirdweb.com/dashboard/settings/api-keys)
VITE_THIRDWEB_CLIENT_ID=

# Coinbase OnchainKit
VITE_PUBLIC_ONCHAINKIT_API_KEY=
VITE_CHAIN=baseSepolia
